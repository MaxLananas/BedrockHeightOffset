<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.buildtheearth</groupId>
    <artifactId>skywindow</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>SkyWindow</name>
    <description>SkyWindow: a Geyser extension that lets Bedrock players build at extreme Java-world heights without rubber-banding</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <!--
          Geyser build this extension compiles against. The extension runs inside the Geyser
          plugin's classloader (parent-first), so the shaded mcprotocollib / cloudburst-protocol /
          netty classes it provides are the exact runtime classes - they are compileOnly here and
          never bundled. Bump together with the target Geyser build and re-run /skywindow doctor.
        -->
        <geyser.version>2.11.2-SNAPSHOT</geyser.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <repositories>
        <repository>
            <id>opencollab</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          Geyser publishes api + core to the OpenCollab repo; core brings mcprotocollib, cloudburst
          and netty as compile-scope transitive dependencies (gradle api() -> maven compile), so the
          exact runtime classes are on the compile path without bundling anything (all provided).
        -->
        <dependency>
            <groupId>org.geysermc.geyser</groupId>
            <artifactId>api</artifactId>
            <version>${geyser.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.geysermc.geyser</groupId>
            <artifactId>core</artifactId>
            <version>${geyser.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>skywindow-${project.version}</finalName>
        <resources>
            <!-- Single source of truth for the version: the pom. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-serial</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-no-server-plugin-apis</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <!--
                                  This extension talks to Geyser's pipeline only. Depending on a Java
                                  server API (Bukkit/Spigot/Paper/ProtocolLib) would reintroduce the
                                  coupling the rewrite exists to remove; the ban keeps it out for good,
                                  including as a transitive of any future dependency.
                                -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.spigotmc:*</exclude>
                                        <exclude>org.bukkit:*</exclude>
                                        <exclude>io.papermc.paper:*</exclude>
                                        <exclude>com.comphenix.protocol:*</exclude>
                                        <exclude>org.geysermc.geyser:geyser-spigot</exclude>
                                        <exclude>org.geysermc.geyser:geyser-bukkit</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
