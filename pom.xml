<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.buildtheearth</groupId>
    <artifactId>skywindow</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>SkyWindow</name>
    <description>SkyWindow: a Geyser extension that lets Bedrock players build at extreme Java-world heights without rubber-banding</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <!--
          Geyser build this extension compiles against. The extension runs inside the Geyser
          plugin's classloader (parent-first), so the shaded mcprotocollib / cloudburst-protocol /
          netty classes it provides are the exact runtime classes - they are compileOnly here and
          never bundled. Bump together with the target Geyser build and re-run /skywindow doctor.
        -->
        <geyser.version>2.11.2-SNAPSHOT</geyser.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <repositories>
        <repository>
            <id>opencollab</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          Geyser publishes api + core to the OpenCollab repo; core brings mcprotocollib, cloudburst
          and netty as compile-scope transitive dependencies (gradle api() -> maven compile), so the
          exact runtime classes are on the compile path without bundling anything (all provided).
        -->
        <dependency>
            <groupId>org.geysermc.geyser</groupId>
            <artifactId>api</artifactId>
            <version>${geyser.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.geysermc.geyser</groupId>
            <artifactId>core</artifactId>
            <version>${geyser.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>skywindow-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
